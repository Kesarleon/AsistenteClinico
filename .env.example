# =============================================================
# Asistente Clínico 24/7 — Variables de entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas .env a git (está en .gitignore)
# =============================================================

# ── n8n ──────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=cambia_esta_password
# URL pública donde n8n recibe webhooks (sin barra al final)
# Ejemplo con ngrok: https://xxxx.ngrok-free.app
# Ejemplo producción: https://n8n.tudominio.com
N8N_WEBHOOK_URL=http://localhost:5678

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=cambia_esta_password_redis

# ── Kaja Uno ──────────────────────────────────────────────────
KAJA_API_TOKEN=kaja_token_aqui
KAJA_TENANT_SLUG=tu-clinica           # slug de la URL: tu-clinica.kaja.uno
KAJA_BRANCH_ID=br_xxxxxxxxxxxxxxxx    # ID de la sucursal en Kaja
KAJA_BUSINESS_NAME=Audiología Dra. Ejemplo
KAJA_BUSINESS_ADDRESS=Ciudad de México, México

# ── Contactos de escalación (Pilar 2) ─────────────────────────
# Formato internacional sin + ni espacios: 521 + 10 dígitos
DOCTOR_PHONE=521XXXXXXXXXX            # Dra. — alertas médicas urgentes (Cat. C)
SUPPORT_PHONE=521XXXXXXXXXX           # Soporte técnico (Cat. B)

# ── Google Gemini ─────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=AIza_tu_key_aqui

# ── Qdrant (local vía Docker — sin API key) ───────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hearing_aid_manuals
